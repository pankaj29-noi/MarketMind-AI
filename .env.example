# Database Configuration (PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_data_analyst

# LLM Provider Configuration
# REAL LLM MODE: set a real Groq key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Optional Gemini fallback (only used when a real GOOGLE_API_KEY is set)
GOOGLE_API_KEY=your_gemini_api_key
GEMINI_FALLBACK_MODEL=gemini-2.5-flash

# DEMO MODE for Lead Intelligence requirement extraction
# auto  = use deterministic demo extractor when GROQ_API_KEY is missing/placeholder (default)
# true  = same as auto when no valid key; real LLM still wins if GROQ_API_KEY is valid
# false = never use demo extractor (requires a valid GROQ_API_KEY)
DEMO_MODE=auto

# Sandbox Configuration
SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=256
