# Database Configuration (PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_data_analyst

# LLM Provider Configuration
# REAL LLM MODE: set a real Groq key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Optional Gemini fallback from Google AI Studio / Vertex
GOOGLE_API_KEY=your_gemini_api_key
# Model ids only (never an API key)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# --- Local Defog SQLCoder (primary NL→SQL on Apple Silicon / local servers) ---
# Backend: llama.cpp + Metal on Mac (see Defog docs). Transformers needs NVIDIA/large RAM.
# SQLCODER_ENABLED=auto|true|false  (auto = on locally, off on Vercel)
SQLCODER_ENABLED=auto
# Prefer local SQLCoder over Groq/Gemini for SQL generation when available
SQLCODER_PREFER_OVER_API=true
# Optional: path to a local .gguf (otherwise downloads from Hugging Face Hub once)
# SQLCODER_MODEL_PATH=/absolute/path/to/sqlcoder-7b-2.Q3_K_S.gguf
# SQLCODER_HF_REPO=MaziyarPanahi/sqlcoder-7b-2-GGUF
# SQLCODER_HF_FILE=sqlcoder-7b-2.Q3_K_S.gguf
# SQLCODER_MODELS_DIR=./models/sqlcoder
# SQLCODER_N_CTX=2048
# SQLCODER_N_GPU_LAYERS=99
# SQLCODER_MAX_TOKENS=384
# Optional Hub token for higher rate limits (never commit real tokens)
# HF_TOKEN=

# DEMO MODE for Lead Intelligence / analytics offline paths
# auto  = use deterministic demo paths when no valid LLM key is configured (default)
# true  = same as auto when no valid key; real LLM still wins if a key is valid
# false = never prefer deterministic demo paths (requires a valid LLM key)
DEMO_MODE=auto

SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=256

# CSV upload caps
MAX_UPLOAD_BYTES=15728640
MAX_UPLOAD_ROWS=100000

# Comma-separated browser origins allowed by CORS (optional; defaults cover local + Vercel)
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://marketmind-ai-pankaj.vercel.app
