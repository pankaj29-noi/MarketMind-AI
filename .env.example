# Database Configuration (PostgreSQL via docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/autonomous_data_analyst

# LLM Provider Configuration
# REAL LLM MODE: set a real Groq key from https://console.groq.com
GROQ_API_KEY=your_groq_api_key
# Optional Gemini fallback from Google AI Studio / Vertex
GOOGLE_API_KEY=your_gemini_api_key
# Model ids only (never an API key)
GROQ_MODEL=openai/gpt-oss-120b
GEMINI_FALLBACK_MODEL=gemini-2.0-flash

# DEMO MODE for Lead Intelligence / analytics offline paths
# auto  = use deterministic demo paths when no valid LLM key is configured (default)
# true  = same as auto when no valid key; real LLM still wins if a key is valid
# false = never prefer deterministic demo paths (requires a valid LLM key)
DEMO_MODE=auto

SANDBOX_TIMEOUT_SECONDS=10
SANDBOX_MEMORY_LIMIT_MB=256
