{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "fastapi",
  "fluid": true,
  "functions": {
    "backend/main.py": {
      "maxDuration": 300,
      "memory": 1024,
      "excludeFiles": "{frontend/**,docs/**,screenshots/**,backend/tests/**,backend/mcp_server/**,**/*.md,**/*test*,**/__pycache__/**,.git/**,.venv/**}"
    }
  }
}
